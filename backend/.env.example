# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-reasoner 不支持 function calling，务必用 deepseek-chat
LLM_MODEL=deepseek-chat

# ---------- 嵌入 ----------
# bge = BAAI/bge-small-zh-v1.5；hash = 离线确定性嵌入兜底
EMBEDDING_PROVIDER=bge
# 国内网络可打开镜像（fastembed 下载走 GCS，通常不可达，建议用 scripts/fetch_model.py）
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 拍图搜同款 ----------
# DeepSeek 视觉模型（实验版）。图片只能放在 user message，单图上限 384 tokens
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_ENABLED=true
VISION_TIMEOUT=25
# 单图最大 8MB；每用户每分钟最多识别 10 次
IMAGE_MAX_BYTES=8388608
IMAGE_SEARCH_PER_MINUTE=10

# ---------- 主动搭配推荐 ----------
CROSS_SELL_ENABLED=true

# ---------- 检索 ----------
TOP_K=4
RAG_MIN_SCORE=0.18
# 评论召回：条数与相似度下限（评论集合按 product_id 先过滤再排序）
REVIEW_TOP_K=6
REVIEW_MIN_SCORE=0.05
# 单轮最多几轮工具调用（防止模型死循环）
MAX_TOOL_ROUNDS=3

# ---------- 鉴权（上线必须替换）----------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 留空或保持 dev-only-* 时启动会打印告警
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
PASSWORD_MIN_LENGTH=6
# 登录失败限流：窗口期内超过次数直接 429
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ---------- 会话记忆 ----------
# memory = 单进程内存（默认，重启失效）；redis = 多副本共享
SESSION_BACKEND=memory
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=5
SESSION_MAX_SESSIONS=1000
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=sp:sess:

# ---------- 服务 ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 留空用 data/shop.db；测试用 test_shop.db 与开发库隔离
DB_FILE=
